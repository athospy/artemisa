# Copy to .env for local development: cp .env.example .env
# Variable names match capstone/settings.py.

DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Postgres started by `docker compose up -d db` (defaults in docker-compose.yml)
DB_NAME=artemisa
DB_USER=artemisa
DB_PASSWORD=artemisa
DB_HOST=localhost
DB_PORT=54322

# Optional: only needed to generate new AI recaps or run `manage.py eval_recap`.
# The demo tournament's recap ships with the repo.
# ANTHROPIC_API_KEY=
